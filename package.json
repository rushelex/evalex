{
  "name": "evalex-workspace",
  "type": "module",
  "private": true,
  "description": "The evalex packages: a typed formula language and its editor adapters.",
  "author": "Aleksey Shelementev <rushelex@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rushelex/evalex.git"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prebench": "pnpm build",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/codemirror && tsc --noEmit -p packages/prosemirror && tsc --noEmit -p packages/tiptap",
    "lint": "eslint --cache",
    "lint:fix": "pnpm lint --fix"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.12.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.15.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@arethetypeswrong/core": "^0.18.5",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@fast-check/vitest": "^0.5.0",
    "@lezer/highlight": "^1.2.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@tiptap/core": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.4",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "5.0.5",
    "browserslist": "^4.29.4",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "hyperformula": "^3.5.0",
    "jest-leak-detector": "^30.5.1",
    "jsonc-eslint-parser": "^3.3.0",
    "lefthook": "^2.2.1",
    "playwright": "^1.64.1",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.8",
    "taze": "^21.3.0",
    "temporal-polyfill": "^1.0.6",
    "tsdown": "^0.23.2",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "vite-plugin-circular-dependency": "^0.6.0",
    "vitest": "^5.0.5"
  }
}
