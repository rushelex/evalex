{
  "name": "evalex",
  "type": "module",
  "version": "0.0.1",
  "description": "Extensible formula engine with parsing, evaluation and reactive recalculation.",
  "author": "Aleksey Shelementev <rushelex@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/rushelex/evalex#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rushelex/evalex.git"
  },
  "bugs": {
    "url": "https://github.com/rushelex/evalex/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "prebench": "tsdown",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache",
    "lint:fix": "pnpm lint --fix",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@arethetypeswrong/core": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@fast-check/vitest": "^0.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.19.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "5.0.5",
    "browserslist": "^4.29.3",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "hyperformula": "^3.5.0",
    "jest-leak-detector": "^30.5.1",
    "jsonc-eslint-parser": "^3.3.0",
    "lefthook": "^2.2.1",
    "playwright": "^1.64.1",
    "taze": "^21.3.0",
    "tsdown": "^0.23.1",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "vite-plugin-circular-dependency": "^0.6.0",
    "vitest": "^5.0.5"
  },
  "inlinedDependencies": {
    "type-fest": "5.10.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.14.0",
      "onFail": "download"
    }
  }
}
